STOXSIM_IMAGE_TAG=replace-with-tested-40-character-commit-sha

STAGING_WEB_DOMAIN=staging.stoxsim.com
STAGING_API_DOMAIN=api.staging.stoxsim.com
ACME_EMAIL=ops@stoxsim.com

POSTGRES_DB=stoxsim
POSTGRES_USER=stoxsim
POSTGRES_PASSWORD=replace-with-a-long-random-password

JWT_SECRET=replace-with-at-least-32-random-bytes
AUTH_COOKIE_SECURE=true
# Optional admin-only test billing; leave disabled without test credentials.
STOXSIM_BILLING_TEST_ENABLED=false
STOXSIM_PORTFOLIO_HISTORY_ENABLED=true
STOXSIM_PORTFOLIO_HISTORY_BENCHMARK_RETENTION_ENABLED=false
STOXSIM_BILLING_TEST_KEY_ID=
STOXSIM_BILLING_TEST_KEY_SECRET=
STOXSIM_BILLING_TEST_WEBHOOK_SECRET=
STOXSIM_BILLING_TEST_PLUS_PLAN=
STOXSIM_BILLING_TEST_PRO_PLAN=
RATE_LIMIT_ENABLED=true

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-password
MAIL_FROM=no-reply@stoxsim.com
MAIL_STARTTLS=true

GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
FINWIZ_AI_ENABLED=true
FINWIZ_MAX_QUESTION_CHARACTERS=2000
FINWIZ_MAX_OUTPUT_TOKENS=900
FINWIZ_THINKING_LEVEL=minimal

SEC_USER_AGENT=StoxSim/1.0 support.stoxsim@gmail.com
SEC_MAX_REQUESTS_PER_SECOND=8

UPSTOX_ANALYTICS_TOKEN=
UPSTOX_STREAM_ENABLED=false

ALPACA_API_KEY_ID=replace-with-alpaca-key-id
ALPACA_API_SECRET_KEY=replace-with-alpaca-secret-key
ALPACA_DATA_FEED=iex
ALPACA_INSTRUMENT_SYNC_ON_STARTUP=true
ALPACA_POLLING_ENABLED=true
ALPACA_POLLING_INTERVAL_MILLIS=5000

SIMULATED_SLIPPAGE_BASIS_POINTS=5

BACKUP_RETENTION_DAYS=14

# Optional Google sign-in for explicitly linked existing accounts (web client ID).
GOOGLE_SIGN_IN_ENABLED=false
GOOGLE_ANDROID_CLIENT_IDS=
GOOGLE_CLIENT_ID=

# Enable after verified provider acceptance; see docs/FINWIZ_WORKSPACE.md.
STOXSIM_BSE_EQUITIES_ENABLED=false
STOXSIM_INDEX_DERIVATIVES_ENABLED=false

# Optional Finwiz providers. Do not enable until account limits and terms verified.
GROQ_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
OPENROUTER_API_KEY=
FINWIZ_GROQ_ENABLED=false
FINWIZ_GROQ_FREE_CAPACITY_CONFIRMED=false
GROQ_MODEL=openai/gpt-oss-20b
FINWIZ_GROQ_DAILY_LIMIT=100
FINWIZ_CLOUDFLARE_ENABLED=false
FINWIZ_CLOUDFLARE_FREE_CAPACITY_CONFIRMED=false
CLOUDFLARE_AI_MODEL=@cf/openai/gpt-oss-20b
FINWIZ_CLOUDFLARE_DAILY_LIMIT=50
FINWIZ_OPENROUTER_ENABLED=false
FINWIZ_OPENROUTER_FREE_CAPACITY_CONFIRMED=false
OPENROUTER_MODEL=
OPENROUTER_UPSTREAM=
FINWIZ_OPENROUTER_DAILY_LIMIT=30
FINWIZ_GEMINI_DAILY_LIMIT=500
FINWIZ_ATTEMPT_TIMEOUT_SECONDS=8
FINWIZ_DEADLINE_SECONDS=25
FINWIZ_PROVIDER_CONCURRENCY=4
FINWIZ_BASIC_DAILY_REQUESTS=10
FINWIZ_EXPANDED_DAILY_REQUESTS=30
FINWIZ_FULL_DAILY_REQUESTS=60
FINWIZ_GLOBAL_DAILY_ATTEMPTS=500

# Conservative estimated token admission limits; adjust to verified account quotas.
FINWIZ_GEMINI_REQUESTS_PER_MINUTE=10
FINWIZ_GEMINI_TOKENS_PER_MINUTE=40000
FINWIZ_GEMINI_TOKENS_PER_DAY=1000000
FINWIZ_GROQ_REQUESTS_PER_MINUTE=5
FINWIZ_GROQ_TOKENS_PER_MINUTE=8000
FINWIZ_GROQ_TOKENS_PER_DAY=180000
FINWIZ_CLOUDFLARE_REQUESTS_PER_MINUTE=5
FINWIZ_CLOUDFLARE_TOKENS_PER_MINUTE=8000
FINWIZ_CLOUDFLARE_TOKENS_PER_DAY=180000
FINWIZ_OPENROUTER_REQUESTS_PER_MINUTE=5
FINWIZ_OPENROUTER_TOKENS_PER_MINUTE=8000
FINWIZ_OPENROUTER_TOKENS_PER_DAY=180000

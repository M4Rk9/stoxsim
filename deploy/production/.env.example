STOXSIM_IMAGE_TAG=replace-with-tested-40-character-commit-sha

PRODUCTION_WEB_DOMAIN=stoxsim.com
PRODUCTION_WWW_DOMAIN=www.stoxsim.com
PRODUCTION_API_DOMAIN=api.stoxsim.com
ACME_EMAIL=support.stoxsim@gmail.com

POSTGRES_DB=stoxsim
POSTGRES_USER=stoxsim
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-different-long-random-password
REDIS_SSL_ENABLED=false

JWT_SECRET=replace-with-at-least-32-random-bytes
AUTH_COOKIE_SECURE=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_REFRESH_PER_MINUTE=60
RATE_LIMIT_FINWIZ_PER_MINUTE=15
RATE_LIMIT_WRITES_PER_MINUTE=120

MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=replace-with-resend-api-key
MAIL_FROM=no-reply@mail.stoxsim.com
MAIL_STARTTLS=true

ALERT_EMAIL_TO=support.stoxsim@gmail.com
METRICS_SCRAPE_TOKEN=replace-with-at-least-32-random-characters
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
LOGGING_STRUCTURED_FORMAT_CONSOLE=ecs

GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
FINWIZ_AI_ENABLED=true
FINWIZ_MAX_QUESTION_CHARACTERS=2000
FINWIZ_MAX_OUTPUT_TOKENS=900
FINWIZ_THINKING_LEVEL=minimal

UPSTOX_ANALYTICS_TOKEN=replace-with-approved-read-only-token
UPSTOX_INSTRUMENT_SYNC_ON_STARTUP=true
UPSTOX_STREAM_ENABLED=true

ALPACA_API_KEY_ID=replace-with-alpaca-key-id
ALPACA_API_SECRET_KEY=replace-with-alpaca-secret-key
ALPACA_DATA_FEED=iex
ALPACA_INSTRUMENT_SYNC_ON_STARTUP=true
ALPACA_POLLING_ENABLED=true
ALPACA_POLLING_INTERVAL_MILLIS=5000

SEC_USER_AGENT=StoxSim/1.0 support.stoxsim@gmail.com
SIMULATED_SLIPPAGE_BASIS_POINTS=5

BACKUP_BEFORE_DEPLOY=true
BACKUP_RETENTION_DAYS=7
BACKUP_S3_URI=s3://replace-with-private-bucket/stoxsim/production
REQUIRE_OFFSITE_BACKUP=true

{
	email {$ACME_EMAIL}
}

# Reject deployment secrets and repository metadata before reaching either app.
(sensitive_paths_matcher) {
    @sensitive_path path_regexp sensitive_path (?i)(^|/)(\.env([./]|$)|\.(git|hg|svn|ssh|aws|idea|vscode|next)(/|$)|\.DS_Store(/|$))
}

(block_sensitive_paths) {
    import sensitive_paths_matcher
    respond @sensitive_path 404
}

{$PRODUCTION_WWW_DOMAIN} {
    import sensitive_paths_matcher
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
	route {
		respond @sensitive_path 404
		redir https://{$PRODUCTION_WEB_DOMAIN}{uri} permanent
	}
}

{$PRODUCTION_WEB_DOMAIN} {
	import block_sensitive_paths
	encode zstd gzip
	# Preserve the frontend's per-response nonce policy; fail closed if absent.
	header ?Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
		-X-Powered-By
	}
	reverse_proxy frontend:3000 {
		# Spring/Next must use Caddy's sanitized X-Forwarded-* headers.
		header_up -Forwarded
	}
}

{$PRODUCTION_API_DOMAIN} {
	import block_sensitive_paths
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	@auth_api path /api/v1/auth/*
	header @auth_api >Cache-Control "no-store"

	@private_metrics path /actuator/prometheus
	respond @private_metrics 404

	request_body {
		max_size 64KiB
	}
	reverse_proxy backend:8080 {
		# Strip caller-controlled RFC 7239 addresses before IP quota enforcement.
		header_up -Forwarded
	}
}
